---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found (404)';
const description = 'The requested reference page could not be found on Home Reference.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://homereference.org/404.html"
  currentPath="/404"
  noindex={true}
>
  <section class="py-16 sm:py-24 max-w-2xl mx-auto text-center space-y-6">
    <div class="text-xs font-mono uppercase tracking-widest text-[#8C4736] font-semibold">
      Error 404 · Page Not Found
    </div>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1C1917] tracking-tight">
      Reference Page Not Found
    </h1>
    <p class="text-sm sm:text-base text-[#57534E] leading-relaxed font-serif">
      The page you requested does not exist or may have moved to an updated canonical path.
      Use the links below to browse published reference guides.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 pt-4 text-xs font-medium">
      <a
        href="/"
        class="px-4 py-2.5 bg-[#1C1917] text-white hover:bg-[#8C4736] transition-colors"
      >
        Return to Home
      </a>
      <a
        href="/systems/"
        class="px-4 py-2.5 bg-white border border-[#E5DFD7] text-[#1C1917] hover:border-[#8C4736] transition-colors"
      >
        Browse Home Systems
      </a>
      <a
        href="/appliances/"
        class="px-4 py-2.5 bg-white border border-[#E5DFD7] text-[#1C1917] hover:border-[#8C4736] transition-colors"
      >
        Browse Appliances
      </a>
    </div>
  </section>
</BaseLayout>
